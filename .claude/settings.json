            "timeout": 120,
            "statusMessage": "PHPStan"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-/home/mgralikowski/Projects/10x/koszykomat}/.claude/hooks/scoped-tests.sh\"",
            "timeout": 120,
            "statusMessage": "Risk-area tests"
