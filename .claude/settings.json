      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-/home/mgralikowski/Projects/10x/koszykomat}/.claude/hooks/pint.sh\"",
            "timeout": 30,
            "statusMessage": "Pint"
